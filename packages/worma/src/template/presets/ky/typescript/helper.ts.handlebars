export function buildPayload(url: string, defaultConfig: Record<string, any>, apiName: string, config: any) {
  const mergedConfig: any = { ...defaultConfig[apiName], ...config };
  const pathParams = mergedConfig.pathParams;
  const resolvedUrl = url.replace(/\{([^}]+)\}/g, (_, key: string) => {
    return pathParams?.[key] ?? _;
  });
  delete mergedConfig.pathParams;
  const json = mergedConfig.json;
  if (Object.prototype.toString.call(json) === '[object Object]' && typeof FormData !== 'undefined') {
    let hasBlobData = false;
    const formData = new FormData();
    for (const key in json) {
      formData.append(key, json[key]);
      if (json[key] instanceof Blob) {
        hasBlobData = true;
      }
    }
    if (hasBlobData) {
      delete mergedConfig.json;
      mergedConfig.body = formData;
    }
  }
  return { url: resolvedUrl, mergedConfig };
}

export type ServicesMap = {
{{#each tagedApis}}
  {{{tagName}}}: typeof import('./services/{{{tagName}}}');
{{/each}}
};

export const setDefaultConfig = <
  T extends keyof ServicesMap,
  TagedMap extends Record<string, (config: any) => any> = ServicesMap[T],
  ConfigMap = { [K in keyof TagedMap]?: Partial<Parameters<TagedMap[K]>[0]> }
>(
  _: T,
  configMap: ConfigMap
) => configMap;